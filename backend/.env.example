# ---------------------------------------------------------------------------
# ScamSathi backend configuration (copy to .env and edit)
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=ScamSathi API
APP_VERSION=1.0.0

# Comma separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite path (relative to the backend directory) or a full sqlite:/// URL.
DATABASE_URL=sqlite:///./scamsathi.db

# Per-IP request limits: "<requests>/<window seconds>"
RATE_LIMIT_ANALYZE=30/60
RATE_LIMIT_DEFAULT=120/60

# Max accepted input sizes
MAX_MESSAGE_CHARS=5000
MAX_URL_CHARS=2048

# --- Optional contextual AI provider -------------------------------------
# none | openai  (openai = any OpenAI-compatible chat completions endpoint)
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=8

# --- Optional URL reputation provider ------------------------------------
# none | google_safebrowsing
URL_REPUTATION_PROVIDER=none
SAFEBROWSING_API_KEY=
